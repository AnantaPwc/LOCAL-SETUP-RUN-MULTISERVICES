+// Shows why the server refused the request (e.g. NULL_PROPERTYID), instead of only the generic failure text.
+// A localization message for the error code is used when one exists, otherwise the server's own message.
+const ApiErrors = ({ error, t }) => {
+  const errors = error?.response?.data?.Errors || [];
+  return errors.map((e, index) => (
+    <CardText key={`${e?.code}-${index}`} style={{ color: "#d4351c" }}>
+      {e?.code && t(e.code) !== e.code ? t(e.code) : e?.message || e?.code}
+    </CardText>
+  ));
+};
