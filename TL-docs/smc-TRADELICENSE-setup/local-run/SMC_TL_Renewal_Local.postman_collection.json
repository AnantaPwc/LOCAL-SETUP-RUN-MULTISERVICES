  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const h = name => pm.request.headers.get(name);",
          "const v = name => pm.collectionVariables.get(name);",
          "const tenant = v('tenantId');",
          "",
          "// Locally there is no gateway: the user is sent in the body and its roles are trusted.",
          "// Both users exist in eg_user. Never use a made-up uuid: it is stored in the workflow history.",
          "const role = h('X-TL-Role');",
          "const users = {",
          "    citizen: { id: Number(v('citizenId')), uuid: v('citizenUuid'), userName: v('citizenMobile'), name: 'OWNER', mobileNumber: v('citizenMobile'), type: 'CITIZEN', tenantId: v('stateTenantId'),",
          "               roles: [{ code: 'CITIZEN', name: 'Citizen', tenantId: v('stateTenantId') }] },",
          "    tlsu1:   { id: Number(v('tlsu1Id')), uuid: v('tlsu1Uuid'), userName: 'TLSU1', name: 'TLSU1', type: 'EMPLOYEE', tenantId: tenant,",
          "               roles: (role ? [role] : v('tlsu1Roles').split(',')).map(r => ({ code: r.trim(), name: r.trim(), tenantId: tenant })) }",
          "};",
          "const requestInfo = { apiId: 'Rainmaker', authToken: 'not-checked-locally', msgId: 'postman|en_IN', userInfo: users[(h('X-TL-User') || 'citizen').toLowerCase()] };",
          "pm.variables.set('requestInfo', JSON.stringify(requestInfo));",
          "",
          "const post = (url, done) => pm.sendRequest({ url, method: 'POST', header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ RequestInfo: requestInfo }) } }, (err, res) => {",
          "        let licenses = [];",
          "        try { licenses = res.json().Licenses || []; } catch (e) { /* not json */ }",
          "        done(licenses);",
          "    });",
          "",
          "// ---- X-TL-Renew: build the renewal request from the issued license ---------------------------------------",
          "if (h('X-TL-Renew')) {",
          "    const number = h('X-TL-LicenseNumber') || v('licenseNumber');",
          "    post(v('tlUrl') + '/tl-services/v1/_search?tenantId=' + tenant + '&licenseNumbers=' + number, licenses => {",
          "        const issued = licenses.filter(l => ['APPROVED', 'EXPIRED'].includes(l.status)).sort((a, b) => b.validTo - a.validTo)[0];",
          "        // an unknown number is sent on the license of {{licenseNumber}}, to show the refusal of tl-services",
          "        const send = issued => {",
          "            issued.licenseNumber = number;",
          "            issued.applicationType = 'RENEWAL';",
          "            issued.workflowCode = 'TL_RENEW';",
          "            issued.action = 'INITIATE';",
          "            if (h('X-TL-ChangeTradeType')) {",
          "                const unit = issued.tradeLicenseDetail.tradeUnits[0];",
          "                unit.tradeType = unit.tradeType === 'GOODS.MANUFACTURE.SMC-01' ? 'GOODS.MANUFACTURE.SMC-03' : 'GOODS.MANUFACTURE.SMC-01';",
          "            }",
          "            pm.variables.set('updateBody', JSON.stringify({ RequestInfo: requestInfo, Licenses: [issued] }, null, 2));",
          "        };",
          "        if (issued) return send(issued);",
          "        post(v('tlUrl') + '/tl-services/v1/_search?tenantId=' + tenant + '&licenseNumbers=' + v('licenseNumber'), others => {",
          "            const other = others.filter(l => ['APPROVED', 'EXPIRED'].includes(l.status))[0];",
          "            if (!other) throw new Error('No issued license found with number ' + v('licenseNumber') + '. Set the collection variable licenseNumber.');",
          "            send(other);",
          "        });",
          "    });",
          "    return;",
          "}",
          "",
          "const action = h('X-TL-Action');",
          "const waitFor = h('X-TL-WaitStatus');",
          "if (!action && !waitFor) return;",
          "",
          "// ---- read the renewal application; the persister writes a few seconds after each call, so retry ----------",
          "const searchUrl = v('tlUrl') + '/tl-services/v1/_search?tenantId=' + tenant + '&applicationNumber=' + v('applicationNumber');",
          "const wanted = waitFor || h('X-TL-From');",
          "let tries = 0;",
          "const search = done => {",
          "    tries++;",
          "    post(searchUrl, licenses => {",
          "        const license = licenses[0];",
          "        if ((license && (!wanted || license.status === wanted)) || tries >= 12) return done(license);",
          "        setTimeout(() => search(done), 2000);",
          "    });",
          "};",
          "",
          "search(license => {",
          "    if (!license) throw new Error('Application ' + v('applicationNumber') + ' not found. Run \"INITIATE the renewal\" first.');",
          "    if (!action) return;                                   // X-TL-WaitStatus only",
          "",
          "    license.action = action;",
          "    // older persister configs blank addressLine1 on every update unless it is sent again",
          "    if (!license.tradeLicenseDetail.address.addressLine1) license.tradeLicenseDetail.address.addressLine1 = v('firmAddress');",
          "    if (h('X-TL-Comment')) license.comment = h('X-TL-Comment');",
          "",
          "    if (action === 'APPLY' || action === 'RESUBMIT') {",
          "        // owner details search may not return (user stand-in, masked values)",
          "        const owner = license.tradeLicenseDetail.owners[0];",
          "        if (!owner.name || owner.name === 'STUB USER') owner.name = v('ownerName');",
          "        if (!owner.mobileNumber) owner.mobileNumber = v('ownerMobile');",
          "        if (!owner.aadhaarNumber) owner.aadhaarNumber = v('ownerAadhaar');",
          "        if (!owner.permanentAddress) owner.permanentAddress = v('ownerAddress');",
          "",
          "        // documents carried over from the previous application keep their id; the renewal documents are added",
          "        const documents = license.tradeLicenseDetail.applicationDocuments || [];",
          "        ['AADHAARCARD', 'SHOPACTLICENSE', 'PREVIOUSLICENSE'].forEach(type => {",
          "            if (h('X-TL-WithoutDocument') === type) return;",
          "            if (!documents.some(d => d.documentType === type && d.active !== false))",
          "                documents.push({ tenantId: tenant, documentType: type, fileStoreId: 'local-test-renewal-' + type.toLowerCase() + '-' + license.applicationNumber, active: true });",
          "        });",
          "        license.tradeLicenseDetail.applicationDocuments = documents;",
          "    }",
          "    pm.variables.set('updateBody', JSON.stringify({ RequestInfo: requestInfo, Licenses: [license] }, null, 2));",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const h = name => pm.request.headers.get(name);",
          "const v = name => pm.collectionVariables.get(name);",
          "const date = millis => millis ? new Date(Number(millis) + 19800000).toISOString().substring(0, 10) : '-';",
          "let body = {};",
          "try { body = pm.response.json(); } catch (e) { /* not json */ }",
          "const errors = (body.Errors || []).map(e => e.code + ': ' + e.message).join(' | ');",
          "",
          "const expectedError = h('X-TL-ExpectError');",
          "if (expectedError) {",
          "    pm.test('refused with ' + expectedError, () => {",
          "        pm.expect(pm.response.code).to.be.at.least(400);",
          "        pm.expect(errors).to.include(expectedError);",
          "    });",
          "    console.log(pm.info.requestName + ' -> ' + errors.substring(0, 300));",
          "    return;",
          "}",
          "pm.test('HTTP 200 / 201', () => {",
          "    if (pm.response.code >= 300) console.log(pm.info.requestName + ' -> ' + (errors || JSON.stringify(body)));",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "});",
          "",
          "const license = body.Licenses && body.Licenses[0];",
          "if (license) {",
          "    const fee = ((license.calculation || {}).taxHeadEstimates || []).map(e => e.taxHeadCode + ' ' + e.estimateAmount).join(', ');",
          "    console.log(pm.info.requestName + ' -> ' + license.applicationNumber + ' (' + license.applicationType + ', ' + license.workflowCode + ') is ' + license.status",
          "        + ', license ' + license.licenseNumber + ', ' + license.financialYear + ' valid ' + date(license.validFrom) + ' to ' + date(license.validTo) + (fee ? ', fee: ' + fee : ''));",
          "    if (h('X-TL-Save') === 'application') pm.collectionVariables.set('applicationNumber', license.applicationNumber);",
          "    const expected = h('X-TL-Expect');",
          "    if (expected) pm.test('status is ' + expected, () => pm.expect(license.status).to.equal(expected));",
          "    if (h('X-TL-ExpectRenewal')) {",
          "        pm.test('is a renewal on workflow TL_RENEW', () => {",
          "            pm.expect(license.applicationType).to.equal('RENEWAL');",
          "            pm.expect(license.workflowCode).to.equal('TL_RENEW');",
          "        });",
          "        pm.test('keeps the license number ' + v('licenseNumber'), () => pm.expect(license.licenseNumber).to.equal(v('licenseNumber')));",
          "        pm.test('has a financial year and validity', () => {",
          "            pm.expect(license.financialYear).to.be.a('string').and.not.empty;",
          "            pm.expect(license.validTo).to.be.above(license.validFrom);",
          "        });",
          "    }",
          "}",
          "if (body.Bill && body.Bill[0]) {",
          "    const bill = body.Bill[0];",
          "    pm.collectionVariables.set('billId', bill.id);",
          "    pm.collectionVariables.set('billAmount', String(bill.totalAmount));",
          "    const heads = ((bill.billDetails || [])[0] || {}).billAccountDetails || [];",
          "    console.log(pm.info.requestName + ' -> bill ' + bill.billNumber + ', amount ' + bill.totalAmount + ' (' + heads.map(a => a.taxHeadCode + ' ' + a.amount).join(', ') + ')');",
          "    pm.test('bill has the renewal fee head', () => pm.expect(heads.map(a => a.taxHeadCode)).to.include('TL_RENEWAL_TAX'));",
          "}",
          "if (body.Payments && body.Payments[0] && pm.request.url.getPath().endsWith('_create')) {",
          "    const payment = body.Payments[0];",
          "    console.log(pm.info.requestName + ' -> receipt ' + payment.paymentDetails[0].receiptNumber + ', paid ' + payment.totalAmountPaid);",
          "    pm.test('receipt is generated', () => pm.expect(payment.paymentDetails[0].receiptNumber).to.be.a('string').and.not.empty);",
          "}",
          "const count = h('X-TL-ExpectCount');",
          "if (count) {",
          "    const list = body.BusinessServices || body.billingSlab || body.BillingSlab || [];",
          "    console.log(pm.info.requestName + ' -> ' + list.length + ' found');",
          "    pm.test('at least ' + count + ' found (setup is loaded)', () => pm.expect(list.length).to.be.at.least(Number(count)));",
          "}"
        ]
      }
    }
  ],
