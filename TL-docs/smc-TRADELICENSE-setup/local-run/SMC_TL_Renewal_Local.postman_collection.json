              {
                "key": "X-TL-ChangeTradeType",
                "value": "true",
                "type": "text"
              },
              {
                "key": "X-TL-User",
                "value": "citizen",
                "type": "text"
              },
              {
                "key": "X-TL-ExpectError",
                "value": "INVALID_TRADETYPE",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{updateBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{tlUrl}}/tl-services/v1/_update",
              "host": [
                "{{tlUrl}}"
