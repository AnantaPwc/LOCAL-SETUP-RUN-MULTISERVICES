{
  "info": {
    "name": "SMC Trade License - MDMS check",
    "description": "Checks the MDMS masters used by the Sangamner trade license (TL_NEW / TTL_NEW).\n\nRun the whole collection (Runner) and read the Test Results. Switch baseUrl between local MDMS (http://localhost:8094) and the demo server (https://sangamner-demo.ddns.net). Folder \"Deferred\" is expected to fail until those masters are added.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8094"
    },
    {
      "key": "stateTenant",
      "value": "pg"
    },
    {
      "key": "cityTenant",
      "value": "pg.smc"
    }
  ],
  "item": [
    {
      "name": "TL masters (ready)",
      "item": [
        {
          "name": "00 MDMS is up (tenants)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const res = (pm.response.json() || {}).MdmsRes || {};",
                  "const list = (m, n) => (res[m] || {})[n] || [];",
                  "pm.test('MDMS returned data (data folder loaded)', () => pm.expect(list('tenant','tenants').length).to.be.above(0));",
                  "console.log('tenants:', list('tenant','tenants').map(t => t.code).join(', '));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"RequestInfo\": {\n    \"apiId\": \"Rainmaker\",\n    \"ver\": \".01\",\n    \"ts\": \"\",\n    \"action\": \"_search\",\n    \"did\": \"1\",\n    \"key\": \"\",\n    \"msgId\": \"20170310130900|en_IN\"\n  },\n  \"MdmsCriteria\": {\n    \"tenantId\": \"{{stateTenant}}\",\n    \"moduleDetails\": [\n      {\n        \"moduleName\": \"tenant\",\n        \"masterDetails\": [\n          {\n            \"name\": \"tenants\"\n          }\n        ]\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/egov-mdms-service/v1/_search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "egov-mdms-service",
                "v1",
                "_search"
              ]
            },
            "description": "Quick health check: MDMS answers and has data loaded. An empty MdmsRes means the data folder was not read (check egov.mdms.conf.path and the startup log)."
          }
        },
        {
          "name": "01 TradeType: 53 SMC business types only",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const res = (pm.response.json() || {}).MdmsRes || {};",
                  "const list = (m, n) => (res[m] || {})[n] || [];",
                  "const tt = list('TradeLicense','TradeType');",
                  "pm.test('53 trade types', () => pm.expect(tt.length).to.eql(53));",
                  "pm.test('all are SMC codes', () => pm.expect(tt.filter(t => !/\\.SMC-\\d{2}$/.test(t.code)).map(t => t.code)).to.eql([]));",
                  "pm.test('no UOM (flat fee)', () => pm.expect(tt.filter(t => t.uom).map(t => t.code)).to.eql([]));",
                  "console.log(tt.map(t => t.code + ' = ' + t.name).join('\\n'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"RequestInfo\": {\n    \"apiId\": \"Rainmaker\",\n    \"ver\": \".01\",\n    \"ts\": \"\",\n    \"action\": \"_search\",\n    \"did\": \"1\",\n    \"key\": \"\",\n    \"msgId\": \"20170310130900|en_IN\"\n  },\n  \"MdmsCriteria\": {\n    \"tenantId\": \"{{stateTenant}}\",\n    \"moduleDetails\": [\n      {\n        \"moduleName\": \"TradeLicense\",\n        \"masterDetails\": [\n          {\n            \"name\": \"TradeType\"\n          }\n        ]\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/egov-mdms-service/v1/_search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "egov-mdms-service",
                "v1",
                "_search"
              ]
            },
            "description": "Annexure 1 business types. Expected: exactly 53, all codes ending .SMC-01 … .SMC-53."
          }
        },
