                  "pm.test('document SHOPACTLICENSE', () => pm.expect(docs).to.include('SHOPACTLICENSE'));",
                  "pm.test('document PREVIOUSLICENSE', () => pm.expect(docs).to.include('PREVIOUSLICENSE'));"
