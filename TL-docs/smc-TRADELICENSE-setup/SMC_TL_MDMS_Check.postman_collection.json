                  "pm.test('TradeLicense.StructureType has MOVABLE.HANDCART', () => pm.expect(list('TradeLicense','StructureType').map(x => x.code)).to.include('MOVABLE.HANDCART'));",
                  "pm.test('TradeLicense.StructureType has MOVABLE.VEHICLE', () => pm.expect(list('TradeLicense','StructureType').map(x => x.code)).to.include('MOVABLE.VEHICLE'));",
                  "pm.test('TradeLicense.StructureType has MOVABLE.STALL', () => pm.expect(list('TradeLicense','StructureType').map(x => x.code)).to.include('MOVABLE.STALL'));"
