        {
          "name": "03 documentObj: SMC documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const res = (pm.response.json() || {}).MdmsRes || {};",
                  "const list = (m, n) => (res[m] || {})[n] || [];",
                  "const docs = ((list('TradeLicense','documentObj')[0] || {}).allowedDocs || []).map(d => d.documentType);",
                  "pm.test('document SEVENTWELVEEXTRACT', () => pm.expect(docs).to.include('SEVENTWELVEEXTRACT'));",
                  "pm.test('document PROPERTYEXTRACT', () => pm.expect(docs).to.include('PROPERTYEXTRACT'));",
                  "pm.test('document AADHAARCARD', () => pm.expect(docs).to.include('AADHAARCARD'));",
                  "pm.test('document PROPERTYTAXRECEIPT', () => pm.expect(docs).to.include('PROPERTYTAXRECEIPT'));",
